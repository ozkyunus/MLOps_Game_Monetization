# ── Player Monetization Intelligence Platform — configuration template ──────
# Copy to `.env` and fill in the CHANGE_ME values. `.env` is gitignored.
#
# WHO READS THIS FILE:
#   • docker compose      → interpolates POSTGRES_* / GOOGLE_API_KEY / PUBLIC_*
#     (container-internal URLs are set in docker-compose.yml itself)
#   • host-side processes → training scripts, pytest, bare-metal uvicorn /
#     streamlit read the URLs below directly
# So every URL here is a HOST-side address (localhost + published ports),
# NOT a compose hostname. (The old template shipped compose hostnames like
# `postgres:5432`, which made host-side tests silently skip and the bare-metal
# pipeline fail with "could not translate host name".)

# ── Postgres (compose interpolation + host URLs) ─────────────────────────────
POSTGRES_USER=train
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=monetization_db

# Host-side connection string (compose publishes postgres on localhost:5434).
# Keep the password in sync with POSTGRES_PASSWORD above.
SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://train:CHANGE_ME@localhost:5434/monetization_db

# ── MLflow (host-side; compose publishes mlflow on localhost:5001) ───────────
MLFLOW_TRACKING_URI=http://localhost:5001

# ── FastAPI (host-side, for bare-metal dashboard runs) ───────────────────────
API_URL=http://localhost:8000

# ── Browser-facing URLs for dashboard link buttons (defaults usually fine) ───
PUBLIC_API_URL=http://localhost:8000
PUBLIC_MLFLOW_URL=http://localhost:5001

# ── LLM (optional — without it /personalized/offer uses fallback templates) ──
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Qdrant vector store (Copilot RAG; compose publishes on localhost:6333) ───
QDRANT_URL=http://localhost:6333
