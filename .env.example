# ────────────────────────────────────────────────────────────
# Player Monetization Intelligence Platform — env template
# Copy to .env and fill in your own values:
#   cp .env.example .env
# ────────────────────────────────────────────────────────────

# Postgres connection.
# docker-compose: hostname is `postgres`, port 5432 inside the network.
# Outside compose (bare uv run): use localhost:5434.
SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://train:CHANGE_ME@postgres:5432/monetization_db

# API base URL — used by the Streamlit dashboard to reach FastAPI.
# docker-compose: http://api:8000. Bare host: http://localhost:8000.
API_URL=http://api:8000

# MLflow tracking + registry.
# docker-compose: http://mlflow:5000. Bare host: http://localhost:5001.
MLFLOW_TRACKING_URI=http://mlflow:5000

# JWT secret for auth endpoints (rotate in production).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# LLM API key for the personalized offer copy service (optional).
# If missing, the endpoint falls back to hand-written templates.
GOOGLE_API_KEY=

# App environment
APP_ENV=production
LOG_LEVEL=INFO
